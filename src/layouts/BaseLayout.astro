---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { site } from '../lib/sections';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.site.defaultTitle, description = site.site.defaultDescription } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef4fb" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(pathname, Astro.site ?? Astro.url)} />
    <title>{title}</title>
  </head>
  <body id="top">
    <div class="page-grid" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label={site.site.brandAriaLabel}>
        <span class="brand-mark">{site.site.brandMark}</span>
        <span>{site.site.brand}</span>
      </a>
      <nav aria-label={site.site.navigationAriaLabel}>
        {site.navigation.map((item) => (
          <a class:list={[{ active: item.href === '/' ? pathname === '/' : pathname.startsWith(item.href) }]} href={item.href}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {site.site.brand}</span>
      <span>{site.site.footerCredit}</span>
    </footer>
    <a class="back-to-top" href="#top" aria-label={site.site.backToTopLabel} title={site.site.backToTopLabel} aria-hidden="true" data-back-to-top data-show-after={site.site.backToTop.showAfterScroll} data-hide-after-up={site.site.backToTop.hideAfterUpScroll}><span class="back-to-top__icon" aria-hidden="true">↑</span></a>
  </body>
</html>

<script>
  const backToTop = document.querySelector<HTMLElement>('[data-back-to-top]');
  const showAfterScroll = Number(backToTop?.dataset.showAfter ?? 320);
  const hideAfterUpScroll = Number(backToTop?.dataset.hideAfterUp ?? 240);
  let isVisible = false;
  let previousScrollY = window.scrollY;
  let upwardDistance = 0;
  let framePending = false;

  const updateBackToTop = () => {
    const currentScrollY = window.scrollY;
    const scrollDelta = currentScrollY - previousScrollY;

    if (!isVisible) {
      if (currentScrollY > showAfterScroll) upwardDistance = 0;
      if (currentScrollY > showAfterScroll) isVisible = true;
    } else if (scrollDelta < 0) {
      upwardDistance -= scrollDelta;
      if (upwardDistance >= hideAfterUpScroll) {
        isVisible = false;
        upwardDistance = 0;
      }
    } else if (scrollDelta > 0) {
      upwardDistance = 0;
    }

    backToTop?.classList.toggle('is-visible', isVisible);
    backToTop?.setAttribute('aria-hidden', String(!isVisible));
    framePending = false;
    previousScrollY = currentScrollY;
  };

  window.addEventListener('scroll', () => {
    if (framePending) return;
    framePending = true;
    window.requestAnimationFrame(updateBackToTop);
  }, { passive: true });
</script>